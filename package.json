{
  "name": "patina-ui",
  "private": true,
  "license": "MIT OR Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "bunx electrobun prepare && vite build && PATINA_DEBUG_BUILD=1 bunx electrobun dev",
    "dev:web": "vite",
    "desktop:prepare": "bunx electrobun prepare",
    "build": "bunx electrobun prepare && vite build",
    "build:app": "bunx electrobun prepare && vite build && bunx electrobun build --env=stable",
    "check": "bunx electrobun prepare && svelte-check --tsconfig ./tsconfig.json && tsc -p tsconfig.desktop.json",
    "test": "playwright test",
    "test:desktop": "bun test desktop"
  },
  "dependencies": {
    "@lucide/svelte": "^1.61.0",
    "smol-toml": "^1.9.1"
  },
  "devDependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@internationalized/date": "^3.12.0",
    "@playwright/test": "^1.64.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tsconfig/svelte": "^5.0.8",
    "@types/bun": "^1.4.4",
    "bits-ui": "^2.20.2",
    "clsx": "^2.1.1",
    "shadcn-svelte": "1.7.0",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.7",
    "tailwind-merge": "^3.7.0",
    "tailwind-variants": "^3.3.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.5"
  }
}
