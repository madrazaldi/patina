{
  "extends": "@tsconfig/svelte/tsconfig.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "types": ["vite/client"],
    "paths": {
      "$lib": ["./web/src/lib"],
      "$lib/*": ["./web/src/lib/*"]
    }
  },
  "include": ["web/src/**/*.ts", "web/src/**/*.svelte"]
}
