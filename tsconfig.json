{
  "extends": "@tsconfig/svelte/tsconfig.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "types": ["vite/client"],
    "paths": {
      "$lib": ["./web/src/lib"],
      "$lib/*": ["./web/src/lib/*"],
      "electrobun/view": ["./.hutch/devkit/api/browser/index.ts"],
      "electrobun/rpc": ["./.hutch/devkit/api/sdks/main/entries/rpc.ts"]
    }
  },
  "include": ["web/src/**/*.ts", "web/src/**/*.svelte", "desktop/rpc.ts"]
}
